generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  hashedPassword String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  role           Role      @default(STUDENT)
  sessions       Session[]
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id      Int      @id @default(autoincrement())
  title   String
  arabic  String
  urdu    String
  slug    String   @unique
  lessons Lesson[]
}

model Lesson {
  id           Int           @id @default(autoincrement())
  title        String
  arabicTitle  String
  slug         String        @unique
  definition   String
  explanation  String
  examples     String
  note         String
  subjectId    Int
  subject      Subject       @relation(fields: [subjectId], references: [id])
  sentences    Sentence[]
  wordMeanings WordMeaning[]
}

model WordMeaning {
  id       Int    @id @default(autoincrement())
  arabic   String
  urdu     String
  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id])
}

model Sentence {
  id       Int    @id @default(autoincrement())
  arabic   String
  urdu     String
  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id])
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}
